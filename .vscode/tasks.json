{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Preview Personal Command Center",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"apps/web",
				"&&",
				"npm",
				"run",
				"dev",
				"--prefix",
				"apps/web"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Restart Personal Command Center Preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"apps/web",
				"&&",
				"npm",
				"run",
				"dev",
				"--prefix",
				"apps/web"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Check Personal Command Center Preview",
			"type": "shell",
			"command": "curl",
			"args": [
				"-I",
				"--max-time",
				"10",
				"http://localhost:3000"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Preview Routes",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"capture:%{http_code} today:%{http_code}\\n",
				"http://localhost:3000/capture",
				"http://localhost:3000/today"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Preview Root",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"root:%{http_code} redirect:%{redirect_url}\\n",
				"http://localhost:3000/"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Running Preview",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"status:%{http_code}\\n",
				"http://localhost:3000/"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start Public Preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"apps/web",
				"--",
				"--hostname",
				"0.0.0.0",
				"--port",
				"3000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start Public Preview 3001",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"apps/web",
				"--",
				"--hostname",
				"0.0.0.0",
				"--port",
				"3001"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify Public Preview 3001",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"root:%{http_code}\\n",
				"http://localhost:3001/"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install 3D Preview Dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--prefix",
				"apps/web"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Redesigned Capture",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"capture:%{http_code}\\n",
				"http://localhost:3001/capture"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Preview Error",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"http://localhost:3001/capture"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify 3D Preview",
			"type": "shell",
			"command": "curl",
			"args": [
				"-sS",
				"-o",
				"/dev/null",
				"-w",
				"status:%{http_code}\\n",
				"http://localhost:3001/capture"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Open 3D Preview",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"$BROWSER https://improved-system-r47xq4jw9qvp3x54-3001.app.github.dev/capture"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}