{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run web preview",
			"type": "shell",
			"command": "cd apps/web && npm run dev -- --hostname 0.0.0.0 --port 3000",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run API preview",
			"type": "shell",
			"command": "python -m uvicorn services.api.main:app --host 0.0.0.0 --port 8000",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Continue rebase tasks",
			"type": "shell",
			"command": "git add .vscode/tasks.json && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Apply README update",
			"type": "shell",
			"command": "git checkout --theirs README.md && git add README.md && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Finish README rebase",
			"type": "shell",
			"command": "git add -A && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restore local task changes",
			"type": "shell",
			"command": "git status --short --branch && git stash list && git stash pop",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push main to origin",
			"type": "shell",
			"command": "git push origin main && git status --short --branch",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}