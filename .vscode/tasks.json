{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run web preview",
			"type": "shell",
			"command": "cd apps/web && npm run dev -- --hostname 0.0.0.0 --port 3000",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run API preview",
			"type": "shell",
			"command": "python -m uvicorn services.api.main:app --host 0.0.0.0 --port 8000",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Continue rebase tasks",
			"type": "shell",
			"command": "git add .vscode/tasks.json && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Apply README update",
			"type": "shell",
			"command": "git checkout --theirs README.md && git add README.md && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Finish README rebase",
			"type": "shell",
			"command": "git add -A && GIT_EDITOR=true git rebase --continue",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restore local task changes",
			"type": "shell",
			"command": "git status --short --branch && git stash list && git stash pop",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push main to origin",
			"type": "shell",
			"command": "git push origin main && git status --short --branch",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect frontend audit",
			"type": "shell",
			"command": "npm view next version && npm audit --audit-level=high --json",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Update Next dependency",
			"type": "shell",
			"command": "npm install --workspace apps/web next@latest",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run frontend build",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run npm audit",
			"type": "shell",
			"command": "npm run audit",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run frontend typecheck",
			"type": "shell",
			"command": "npm run typecheck",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect dependency changes",
			"type": "shell",
			"command": "git status --short --branch && git diff -- apps/web/package.json package.json apps/web/tsconfig.json package-lock.json | sed -n '1,240p'",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}